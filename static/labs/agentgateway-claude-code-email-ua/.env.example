# Placeholders only. Do not put a real provider key in this file.
# The local LLM mock ignores the value. Copy to .env before you start the lab:
#   cp .env.example .env
#
# Point config.yaml baseUrl at https://api.anthropic.com only when you intend
# to send traffic to Anthropic, and put the real key in .env (never in git).
ANTHROPIC_API_KEY=sk-...

# The one account address the prompt guard masks. It must match the regex in
# config.yaml (you@example.com). This is a placeholder, not a real mailbox.
ACCOUNT_EMAIL=you@example.com
